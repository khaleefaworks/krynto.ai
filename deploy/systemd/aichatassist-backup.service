[Unit]
Description=AI ChatAssist Backup (Postgres + uploads)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/aichatassist-backup

# Hardening (keep compatible with writing to /var/backups)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# If uploads are under /home (e.g. /home/frappe/aichatassist-data/uploads),
# ProtectHome=true would block access.
ProtectHome=false

# Runs as root by default (required if /etc/aichatassist/backend.env is 600 root)

[Install]
WantedBy=multi-user.target
