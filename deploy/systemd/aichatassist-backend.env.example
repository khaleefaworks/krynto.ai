# Backend environment (example)
# Copy to: /etc/aichatassist/backend.env

ENV=production
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@127.0.0.1:5432/aichatassist
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Comma-separated list (no '*')
CORS_ALLOWED_ORIGINS=https://dashboard.example.com

# Recommended for widget snippet generation
PUBLIC_BASE_URL=https://api.example.com

# Optional (recommended if running multiple workers/instances)
# REDIS_URL=redis://127.0.0.1:6379/0

# Optional tuning
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
