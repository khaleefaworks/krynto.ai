import { useEffect, useState, useRef } from 'react'
import { useParams, useNavigate } from 'react-router-dom'
import { useAppStore } from '@/store/appStore'
import { useMessageStore } from '@/store/messages'
import { fetchActiveChats as fetchChatsApi } from '@/services/chats'
import { joinChat, closeConversation } from '@/services/chats'
import { fetchChatMessages } from '@/services/messages'
import {
  connectAgentSocket,
  sendAgentMessage,
  disconnectAgentSocket,
} from '@/services/agentSocket'
import { 
  addTag, 
  getTags, 
  deleteTag, 
  addNote, 
  getNotes, 
  deleteNote,
  updateConversationMetadata,
  type Tag,
  type Note
} from '@/services/conversationMetadata'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Badge } from '@/components/ui/badge'
import { 
  Send, 
  Check, 
  MoreVertical, 
  Tag as TagIcon,
  Smile,
  Bold,
  Italic,
  Paperclip,
  Clock,
  MessageSquare,
  Search,
  X,
  ChevronLeft,
  ChevronRight
} from 'lucide-react'
import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from '@/components/ui/dropdown-menu'
import VisitorDetailsPanel from '@/components/VisitorDetailsPanel'
import { formatDistanceToNow } from 'date-fns'
import type { Conversation } from '@/types'

interface ConversationDetails {
  id: number
  session_id: string
  visitor_name?: string
  visitor_email?: string
  visitor_phone?: string
  device_info?: string
  browser_info?: string
  visit_count?: number
  last_seen_at?: string
  created_at?: string
  status?: string
}

export default function ConversationsView() {
  const { conversationId } = useParams<{ conversationId?: string }>()
  const navigate = useNavigate()
  const { user } = useAppStore()
  const { activeChats, setActiveChats } = useAppStore()
  const { messages, addMessage, addMessages, reset } = useMessageStore()
  
  // List state
  const [loading, setLoading] = useState(true)
  const [searchQuery, setSearchQuery] = useState('')
  
  // Chat state
  const [selectedChat, setSelectedChat] = useState<number | null>(null)
  const [input, setInput] = useState('')
  const [chatLoading, setChatLoading] = useState(false)
  const [resolving, setResolving] = useState(false)
  const joinedRef = useRef(false)
  const messagesEndRef = useRef<HTMLDivElement>(null)

  // Conversation details state
  const [conversation, setConversation] = useState<ConversationDetails | null>(null)
  const [tags, setTags] = useState<Tag[]>([])
  const [notes, setNotes] = useState<Note[]>([])
  const [websiteId, setWebsiteId] = useState<number | null>(null)
  
  // Sidebar collapse state
  const [leftSidebarCollapsed, setLeftSidebarCollapsed] = useState(false)
  const [rightSidebarCollapsed, setRightSidebarCollapsed] = useState(false)

  // Load chats list
  useEffect(() => {
    fetchActiveChats()
  }, [])

  // Handle conversation selection from URL
  useEffect(() => {
    if (conversationId && conversationId !== selectedChat?.toString()) {
      setSelectedChat(parseInt(conversationId))
    }
  }, [conversationId])

  // Load chat when selected
  useEffect(() => {
    if (selectedChat && selectedChat.toString() !== conversationId) {
      navigate(`/dashboard/chats/${selectedChat}`, { replace: true })
    }
    
    if (selectedChat) {
      loadChat(selectedChat)
    }
  }, [selectedChat])

  const fetchActiveChats = async () => {
    try {
      setLoading(true)
      const data = await fetchChatsApi()
      setActiveChats(data)
    } catch (err: any) {
      console.error('Failed to fetch active chats:', err)
    } finally {
      setLoading(false)
    }
  }

  const loadChat = async (chatId: number) => {
    if (joinedRef.current) {
      joinedRef.current = false
      disconnectAgentSocket()
    }

    try {
      setChatLoading(true)
      reset()
      
      // Load chat history
      const history = await fetchChatMessages(chatId.toString())
      addMessages(history)

      // Join chat
      const res: any = await joinChat(chatId.toString())
      
      setWebsiteId(res.website_id)
      setConversation({
        id: chatId,
        session_id: res.session_id || "9f7812a5...",
        visitor_name: undefined,
        visitor_email: undefined,
        visitor_phone: undefined,
        device_info: "Linux",
        browser_info: "Chrome 143.0.0.0",
        visit_count: 2,
        last_seen_at: new Date().toISOString(),
        created_at: new Date().toISOString(),
        status: "active"
      })
      
      // Load tags and notes
      loadTagsAndNotes(chatId.toString())

      // Connect WebSocket
      const ws = connectAgentSocket(res.website_id, user!.id)
      
      ws.onopen = () => {
        ws.send(JSON.stringify({
          type: "join_chat",
          conversation_id: chatId,
        }))
        joinedRef.current = true
      }

      ws.onmessage = (event) => {
        const data = JSON.parse(event.data)
        
        if (data.type === "visitor_message") {
          addMessage({
            sender: "visitor",
            content: data.message,
            created_at: new Date().toISOString(),
          })
          if (conversation) {
            setConversation({ ...conversation, last_seen_at: new Date().toISOString() })
          }
        } else if (data.type === "message") {
          addMessage({
            id: data.id,
            sender: data.sender || "visitor",
            content: data.content || data.message,
            created_at: data.created_at,
          })
        }
      }

      setChatLoading(false)
    } catch (error) {
      console.error('Failed to load chat:', error)
      setChatLoading(false)
    }
  }

  const loadTagsAndNotes = async (convId: string) => {
    try {
      const [tagsData, notesData] = await Promise.all([
        getTags(parseInt(convId)),
        getNotes(parseInt(convId))
      ])
      setTags(tagsData)
      setNotes(notesData)
    } catch (error) {
      console.error("Failed to load tags/notes:", error)
    }
  }

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" })
  }, [messages])

  const handleResolve = async () => {
    if (!selectedChat) return
    
    if (!confirm("Mark this conversation as resolved?")) {
      return
    }

    try {
      setResolving(true)
      await closeConversation(selectedChat)
      setSelectedChat(null)
      navigate('/dashboard/chats')
      fetchActiveChats()
    } catch (error) {
      console.error("Failed to resolve conversation:", error)
      alert("Failed to resolve conversation")
    } finally {
      setResolving(false)
    }
  }

  const send = () => {
    if (!input.trim() || !selectedChat) return

    sendAgentMessage(input, selectedChat.toString())
    
    addMessage({ 
      sender: "agent", 
      content: input,
      created_at: new Date().toISOString(),
    })
    
    setInput("")
  }

  const handleKeyPress = (e: React.KeyboardEvent) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault()
      send()
    }
  }

  // Handler functions for VisitorDetailsPanel
  const handleUpdateMetadata = async (data: { visitor_name?: string; visitor_email?: string; visitor_phone?: string }) => {
    if (!selectedChat) return
    try {
      await updateConversationMetadata(selectedChat, data)
      setConversation(prev => prev ? { ...prev, ...data } : null)
    } catch (error) {
      console.error("Failed to update metadata:", error)
    }
  }

  const handleAddTag = async (tagName: string) => {
    if (!selectedChat) return
    try {
      const newTag = await addTag(selectedChat, tagName)
      setTags(prev => [...prev, newTag])
    } catch (error) {
      console.error("Failed to add tag:", error)
    }
  }

  const handleRemoveTag = async (tagId: number) => {
    if (!selectedChat) return
    try {
      await deleteTag(selectedChat, tagId)
      setTags(prev => prev.filter(t => t.id !== tagId))
    } catch (error) {
      console.error("Failed to remove tag:", error)
    }
  }

  const handleAddNote = async (content: string) => {
    if (!selectedChat) return
    try {
      const newNote = await addNote(selectedChat, content)
      setNotes(prev => [...prev, newNote])
    } catch (error) {
      console.error("Failed to add note:", error)
    }
  }

  const handleDeleteNote = async (noteId: number) => {
    if (!selectedChat) return
    try {
      await deleteNote(selectedChat, noteId)
      setNotes(prev => prev.filter(n => n.id !== noteId))
    } catch (error) {
      console.error("Failed to delete note:", error)
    }
  }

  const filteredChats = activeChats.filter(chat => {
    if (!searchQuery) return true
    return chat.session_id.toLowerCase().includes(searchQuery.toLowerCase())
  })

  return (
    <div className="flex h-screen bg-gray-50 dark:bg-gray-900">
      {/* LEFT: Conversations List */}
      <div className="w-80 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 flex flex-col">
        {/* Header */}
        <div className="p-4 border-b border-gray-200 dark:border-gray-700">
          <div className="flex items-center justify-between mb-3">
            <h2 className="text-xl font-bold text-gray-900 dark:text-white">Chats</h2>
            <Button
              variant="ghost"
              size="sm"
              onClick={fetchActiveChats}
              className="dark:text-gray-300"
            >
              Refresh
            </Button>
          </div>
          
          {/* Search */}
          <div className="relative">
            <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 h-4 w-4 text-gray-400" />
            <Input
              placeholder="Search conversations..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className="pl-10 dark:bg-gray-700 dark:border-gray-600"
            />
          </div>
          
          <p className="text-sm text-gray-500 dark:text-gray-400 mt-2">
            {filteredChats.length} conversation{filteredChats.length !== 1 ? 's' : ''} waiting
          </p>
        </div>

        {/* Conversations List */}
        <div className="flex-1 overflow-y-auto">
          {loading ? (
            <div className="flex items-center justify-center h-32">
              <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
            </div>
          ) : filteredChats.length === 0 ? (
            <div className="text-center p-8 text-gray-400 dark:text-gray-600">
              <MessageSquare className="h-12 w-12 mx-auto mb-2 opacity-50" />
              <p>No active conversations</p>
            </div>
          ) : (
            <div className="divide-y divide-gray-200 dark:divide-gray-700">
              {filteredChats.map((chat) => (
                <button
                  key={chat.id}
                  onClick={() => setSelectedChat(chat.id)}
                  className={`w-full p-4 text-left hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors ${
                    selectedChat === chat.id ? 'bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-600' : ''
                  }`}
                >
                  <div className="flex items-start gap-3">
                    <div className="w-12 h-12 rounded-full bg-gradient-to-br from-purple-500 to-blue-600 flex items-center justify-center text-white font-bold flex-shrink-0">
                      {chat.session_id.substring(0, 2).toUpperCase()}
                    </div>
                    <div className="flex-1 min-w-0">
                      <div className="flex items-center justify-between mb-1">
                        <span className="font-semibold text-gray-900 dark:text-white truncate">
                          {chat.session_id.substring(0, 8)}...
                        </span>
                        <span className="text-xs text-gray-500 dark:text-gray-400">
                          {chat.message_count || 0} msgs
                        </span>
                      </div>
                      <p className="text-sm text-gray-600 dark:text-gray-400 truncate">
                        Session: {chat.session_id.substring(0, 12)}...
                      </p>
                      <div className="flex items-center gap-2 mt-1">
                        <Badge variant="secondary" className="text-xs">
                          {chat.status}
                        </Badge>
                        {chat.is_handoff && (
                          <Badge variant="outline" className="text-xs text-orange-600">
                            Needs agent
                          </Badge>
                        )}
                      </div>
                    </div>
                  </div>
                </button>
              ))}
            </div>
          )}
        </div>
      </div>

      {/* MIDDLE: Chat Messages */}
      {selectedChat ? (
        <div className="flex-1 flex flex-col">
          {/* Chat Header */}
          <div className="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 px-4 py-3">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-3">
                <div>
                  <h2 className="text-lg font-semibold text-gray-900 dark:text-white">
                    {conversation?.visitor_name || conversation?.session_id.substring(0, 8) || `Chat #${selectedChat}`}
                  </h2>
                  {conversation?.last_seen_at && (
                    <p className="text-xs text-gray-500 dark:text-gray-400 flex items-center gap-1">
                      <Clock className="h-3 w-3" />
                      Last seen {formatDistanceToNow(new Date(conversation.last_seen_at), { addSuffix: true })}
                    </p>
                  )}
                </div>
              </div>

              {/* Header Actions */}
              <div className="flex items-center gap-2">
                <Button
                  variant="ghost"
                  size="sm"
                  className="dark:text-gray-300 dark:hover:bg-gray-700"
                >
                  <TagIcon className="h-4 w-4 mr-1" />
                  Tag
                </Button>

                <Button
                  variant="default"
                  size="sm"
                  onClick={handleResolve}
                  disabled={resolving}
                  className="bg-green-600 hover:bg-green-700 text-white"
                >
                  <Check className="h-4 w-4 mr-1" />
                  {resolving ? "Resolving..." : "Resolve"}
                </Button>

                <DropdownMenu>
                  <DropdownMenuTrigger asChild>
                    <Button variant="ghost" size="sm" className="dark:text-gray-300">
                      <MoreVertical className="h-4 w-4" />
                    </Button>
                  </DropdownMenuTrigger>
                  <DropdownMenuContent align="end">
                    <DropdownMenuItem onClick={() => setShowRightSidebar(!showRightSidebar)}>
                      {showRightSidebar ? "Hide" : "Show"} visitor details
                    </DropdownMenuItem>
                    <DropdownMenuItem className="text-red-600" onClick={handleResolve}>
                      Close conversation
                    </DropdownMenuItem>
                  </DropdownMenuContent>
                </DropdownMenu>
              </div>
            </div>

            {/* Tags Display */}
            {tags.length > 0 && (
              <div className="flex gap-2 mt-2">
                {tags.map(tag => (
                  <Badge key={tag.id} variant="secondary" className="text-xs">
                    {tag.tag_name}
                  </Badge>
                ))}
              </div>
            )}
          </div>

          {/* Messages Area */}
          <div className="flex-1 overflow-y-auto p-4 space-y-4 bg-gray-50 dark:bg-gray-900">
            {chatLoading ? (
              <div className="flex items-center justify-center h-full">
                <div className="text-center">
                  <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
                  <p className="text-gray-600 dark:text-gray-400">Loading chat...</p>
                </div>
              </div>
            ) : messages.length === 0 ? (
              <p className="text-center text-gray-400 dark:text-gray-600 text-sm mt-8">
                No messages yet...
              </p>
            ) : (
              messages.map((m, i) => {
                const isSystem = m.sender === "system"
                const isAgent = m.sender === "agent"
                const isAI = m.sender === "ai"

                if (isSystem) {
                  return (
                    <div key={i} className="flex justify-center">
                      <div className="bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-200 px-4 py-2 rounded-full text-xs font-medium">
                        {m.content}
                      </div>
                    </div>
                  )
                }

                return (
                  <div
                    key={i}
                    className={`flex ${isAgent ? "justify-end" : "justify-start"}`}
                  >
                    <div
                      className={`max-w-[70%] rounded-2xl px-4 py-3 shadow-sm ${
                        isAgent
                          ? "bg-blue-600 text-white"
                          : "bg-white text-gray-800 border border-gray-200 dark:bg-gray-800 dark:text-gray-200 dark:border-gray-700"
                      }`}
                    >
                      <p className="text-sm leading-relaxed break-words whitespace-pre-wrap">{m.content}</p>
                      <div className="flex items-center justify-between mt-2 gap-2">
                        {!isAgent && (
                          <span className={`text-xs font-medium ${isAgent ? 'text-blue-100' : 'text-gray-500 dark:text-gray-400'}`}>
                            {isAI ? '🤖 AI' : '👤 Visitor'}
                          </span>
                        )}
                        {m.created_at && (
                          <span className={`text-xs ${isAgent ? 'text-blue-100' : 'text-gray-400'} ml-auto`}>
                            {new Date(m.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                )
              })
            )}
            <div ref={messagesEndRef} />
          </div>

          {/* Input Area */}
          <div className="border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
            {/* Toolbar */}
            <div className="flex items-center gap-1 px-4 py-2 border-b border-gray-200 dark:border-gray-700">
              <Button variant="ghost" size="sm" className="h-8 w-8 p-0">
                <Bold className="h-4 w-4" />
              </Button>
              <Button variant="ghost" size="sm" className="h-8 w-8 p-0">
                <Italic className="h-4 w-4" />
              </Button>
              <Button variant="ghost" size="sm" className="h-8 w-8 p-0">
                <Smile className="h-4 w-4" />
              </Button>
              <Button variant="ghost" size="sm" className="h-8 w-8 p-0">
                <Paperclip className="h-4 w-4" />
              </Button>
              <div className="ml-auto text-xs text-gray-500 dark:text-gray-400">
                Press Enter to send
              </div>
            </div>

            <div className="flex gap-3 p-4">
              <Input
                value={input}
                onChange={(e) => setInput(e.target.value)}
                onKeyPress={handleKeyPress}
                placeholder="Type your message..."
                className="flex-1 dark:bg-gray-700 dark:border-gray-600"
              />
              <Button 
                onClick={send} 
                disabled={!input.trim()} 
                className="bg-blue-600 hover:bg-blue-700 px-6"
              >
                <Send className="h-4 w-4 mr-2" />
                Send
              </Button>
            </div>
          </div>
        </div>
      ) : (
        <div className="flex-1 flex items-center justify-center bg-gray-50 dark:bg-gray-900">
          <div className="text-center text-gray-400 dark:text-gray-600">
            <MessageSquare className="h-16 w-16 mx-auto mb-4 opacity-50" />
            <p className="text-lg">Select a conversation to start chatting</p>
          </div>
        </div>
      )}

      {/* RIGHT: Visitor Details */}
      {showRightSidebar && selectedChat && conversation && (
        <VisitorDetailsPanel
          conversation={conversation}
          tags={tags}
          notes={notes}
          onUpdateMetadata={handleUpdateMetadata}
          onAddTag={handleAddTag}
          onRemoveTag={handleRemoveTag}
          onAddNote={handleAddNote}
          onDeleteNote={handleDeleteNote}
        />
      )}
    </div>
  )
}
