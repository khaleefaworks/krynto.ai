# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/ai_chatassist

# Environment (development, production, staging)
ENV=development

# Security - CHANGE THIS IN PRODUCTION!
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-please

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_CHAT_MESSAGE=10

# Agent Inactivity Timeout (in seconds)
# After this time without activity, conversations are auto-released
AGENT_INACTIVITY_TIMEOUT_SECONDS=900
