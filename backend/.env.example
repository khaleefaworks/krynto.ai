ENV=development

# Local DB (Postgres) - required for development.
DATABASE_URL=postgresql+psycopg2://chatassist:chatassist@localhost:5432/chatassist

# Required in production; recommended in dev.
SECRET_KEY=dev-only-change-me

# Used for widget snippet generation and absolute URLs where needed.
PUBLIC_BASE_URL=http://localhost:8000

# Uploads root (optional). If unset, defaults to <repo-root>/uploads.
#UPLOADS_DIR=/absolute/path/to/ai-chatassist/uploads

# Redis (optional in dev)
REDIS_URL=redis://127.0.0.1:6379/0

# Web Push (VAPID) - required for push subscription + sending test push.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:dev@localhost

# Resend (email delivery)
RESEND_API_KEY=your-resend-api-key
# Use Resend's shared test domain until you verify your own domain
FROM_EMAIL=AI ChatAssist <onboarding@resend.dev>
# Used for building password-reset links in emails
FRONTEND_URL=http://localhost:5173
# Redirect ALL outgoing emails to this address (Resend shared-domain restriction).
# Remove when a custom domain is verified in Resend.
RESEND_OVERRIDE_TO_EMAIL=your-email@example.com